{
  "name": "nurumayueditor",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "description": "NurumayuEditor — a local-first Markdown, document, and slide editor with AI assistance.",
  "author": "Satoshi Kume",
  "license": "Artistic-2.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "cytoscape": "^3.30.2",
    "mermaid": "^11.4.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/cytoscape": "^3.21.8",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.6"
  },
  "comments": {
    "overrides": "esbuild pinned to >=0.28.1 to patch GHSA-g7r4-m6w7-qqqr (dev-server file read on Windows). vite 7.x pins esbuild ^0.27.0, but 0.28.x is API-compatible (vite 8 uses it). This is a dev/build-time tool only — not bundled into the shipped app. Remove the override once vite ships a release on a patched esbuild."
  },
  "overrides": {
    "esbuild": ">=0.28.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
